{
    "name": "decole/planka-php-sdk",
    "type": "library",
    "description": "An easy-to-use PHP SDK for Planka v2 API.",
    "keywords": ["planka", "api", "sdk", "kanban"],
    "homepage": "https://github.com/decole/planka-php-sdk",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Galochkin Sergey",
            "email": "decole@rambler.ru"
        },
        {
            "name": "Airy",
            "email": "airy@live.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "symfony/http-client": "^6.4|^7.0",
        "symfony/mime": "^6.4|^7.0",
        "fp4php/functional": "^6.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "symfony/var-dumper": "^6.4|^7.0",
        "vimeo/psalm": "^5.11|^6.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Planka\\Bridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Planka\\Bridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "scripts": {
        "test": [
            "@php ./vendor/bin/phpunit --testsuite=Unit"
        ],
        "test-integration": [
            "@php ./vendor/bin/phpunit --testsuite=Integration"
        ],
        "fix-cs": [
            "@php ./vendor/bin/php-cs-fixer fix --diff -v --allow-risky=yes --ansi"
        ]
    }
}
